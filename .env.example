# Copy is generated for you: run `npm run env:init` (creates .env once, never
# overwrites). Secrets below are left blank here on purpose and are filled by
# that command. Never commit .env.
SITE_NAME=Los Tres
APP_PORT=3010
DB_USER=lostres
DB_PASSWORD=
DB_NAME=lostres
DB_HOST_PORT=5433
DATABASE_URL=
# Admin sign-in. AUTH_SECRET signs the session cookie (generated by env:init).
# SITE_URL is the address the site is opened at (derived by env:init from
# APP_PORT); the sign-in form only works from exactly this origin. It is also
# the public origin used for canonical links, the sitemap and the Sitemap line
# of robots.txt. Before a public deploy it must be the public https origin.
AUTH_SECRET=
SITE_URL=
SEED_DEMO_DATA=true
E2E_BASE_URL=
# Owner identity for the legal pages. Fill in .env; never commit real values.
OWNER_NAME=
OWNER_NIF=
OWNER_ADDRESS=
OWNER_REGISTRY=
CONTACT_EMAIL=
