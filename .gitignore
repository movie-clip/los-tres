# Secrets — never committed (guardrail: personal data and secrets)
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
build/
.venv/
__pycache__/

# Logs
*.log

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock

# Next.js and test output
.next/
next-env.d.ts
*.tsbuildinfo
playwright-report/
test-results/
timing-results/

# Written at the repo root by next build and next dev; never commit it
AGENTS.md
agentic/runs/

# Catalogue files (S3.7): a hand-placed feed file is never committed. Only the
# placeholder is tracked, so the folder exists on every clone.
/catalogue-files/*
!/catalogue-files/.gitkeep
