{
  "name": "los-tres",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "env:init": "node scripts/init-env.mjs",
    "db:up": "docker compose up -d --wait db",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "cli:build": "tsc -p tsconfig.cli.json",
    "db:migrate": "npm run cli:build && node --env-file=.env --conditions=react-server dist/cli/migrate.js",
    "db:seed": "npm run cli:build && node --env-file=.env --conditions=react-server dist/cli/seed.js",
    "import-feeds": "npm run cli:build && node --env-file=.env --conditions=react-server dist/cli/import-feeds.js",
    "create-admin": "npm run cli:build && node --env-file=.env --conditions=react-server dist/cli/create-admin.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "gate": "npm run lint && npm run typecheck && npm run db:up && npm test && npm run stack:up && npm run test:e2e"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
