{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/../.agentic/scripts/hooks/report_artifact_gate.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/../.agentic/scripts/hooks/report_head_gate.py\""
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["github"],
  "permissions": {
    "deny": [
      "mcp__github__merge_pull_request",
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push origin HEAD:main:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)"
    ]
  },
  "enabledPlugins": {
    "agentic-core@agentic": true,
    "mattpocock-skills@claude-plugins-official": true
  }
}
